# Copy to .env (gitignored). `alchemy deploy` and `alchemy plan` load it. See docs/deploy.md.

# Custom domains, once the zone is in the Cloudflare account. Unset = workers.dev URL only.
# SITE_DOMAIN_PROD=example.com
# SITE_DOMAIN_DEV=dev.example.com

# /admin (Cloudflare Access; docs/deploy.md, "Admin page"). The Zero Trust team domain, and the
# one email address allowed into /admin. Both stages share them. Unset = /admin is a 404.
# ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# ADMIN_EMAIL=you@example.com

# Opt out of Alchemy's anonymous CLI telemetry.
# ALCHEMY_TELEMETRY_DISABLED=1

# CI only (a GitHub Action has no browser login). On your own machines use
# `bun alchemy profile edit --add Cloudflare` instead, and never commit a token.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
