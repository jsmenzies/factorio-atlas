// Local tooling only: `vite dev` (adapter-cloudflare's getPlatformProxy), `wrangler d1 ... --local`,
// `wrangler types`, `bun run preview` and scripts/ingest.ts, all on miniflare state under
// .wrangler/state. Deploys go through alchemy.run.ts, which reads the compatibility settings,
// vars and binding names from this file; never `wrangler deploy` with it. See docs/deploy.md.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "factorio-atlas",
	"compatibility_date": "2026-10-18",
	"compatibility_flags": ["nodejs_als"],
	// No `main` or assets binding here: adapter-cloudflare still writes .svelte-kit/cloudflare/_worker.js,
	// and with `main` set, `wrangler types` would import the build output once it exists, so the
	// generated types (and `bun run check`) would depend on whether a build had run. The deployed
	// Worker gets its ASSETS binding from alchemy.run.ts; nothing in src uses it.
	"assets": {
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"preview_urls": false,
	// Local only. database_id is not a real database: miniflare keys the local D1 file by it, so
	// changing or removing it starts an empty local database (then `bun run db:reset` and
	// `bun run ingest --from-disk`). Real databases are created and bound by alchemy.run.ts.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prints",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		// Raw source records (one JSON object per print), keyed `factorioprints/<id>.json`.
		{ "binding": "RAW", "bucket_name": "prints-raw" },
		// Game-look renders made offline by `bun run render`, keyed `<id>/<page>.avif|.json|.page.json`, `<id>/t/<hash>.avif` and `<id>/index.json`.
		{ "binding": "RENDERS", "bucket_name": "prints-renders" },
		// Game art served as static files (`bun run icons`), keyed `icons/<set>/<type>/<name>.webp`.
		{ "binding": "SPRITES", "bucket_name": "prints-sprites" },
		// Copies of the prints' Imgur screenshots (`bun run screenshots --upload`), keyed by Imgur id: `<id>.<ext>`,
		// `<id>.v<V>.<size>.<ext>` and the manifest `<id>.json` (src/lib/screenshots.ts).
		{ "binding": "SCREENSHOTS", "bucket_name": "prints-screenshots" }
	],
	// Requests per visitor (IP, or IPv6 /64) per 60 s, counted per Cloudflare location
	// (src/lib/server/rate-limit.ts). Every request counts towards PAGE_LIMIT; searches towards
	// SEARCH_LIMIT too. Periods can only be 10 or 60 s. namespace_id must be unique in the account.
	"ratelimits": [
		{ "name": "PAGE_LIMIT", "namespace_id": "4101", "simple": { "limit": 150, "period": 60 } },
		{ "name": "SEARCH_LIMIT", "namespace_id": "4102", "simple": { "limit": 40, "period": 60 } },
		// Removal requests sent (POST /prints/<id>/remove).
		{ "name": "REPORT_LIMIT", "namespace_id": "4104", "simple": { "limit": 5, "period": 60 } }
	],
	// One data point per print page view (src/routes/prints/[id]/view). Locally the writes go nowhere;
	// alchemy.run.ts binds each stage's own dataset (viewsDataset in infra/databases.ts).
	"analytics_engine_datasets": [{ "binding": "VIEWS", "dataset": "factorio_prints_local_views" }],
	"vars": {
		"MIRROR_BASE_URL": "https://raw.githubusercontent.com/motlin/factorio-blueprint-firebase-cdn/main",
		"FIREBASE_BASE_URL": "https://facorio-blueprints.firebaseio.com",
		// /admin (Cloudflare Access). Empty here: local `vite dev` allows /admin without them, and
		// alchemy.run.ts sets them per stage. Unset in a deployed stage, /admin is a 404.
		// See docs/deploy.md, "Admin page".
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": "",
		// Origin of the SPRITES bucket's custom domain, e.g. https://sprites.example.com. Empty means
		// the Worker serves sprites itself at /sprites/<key>; alchemy.run.ts sets it from SPRITES_DOMAIN.
		"SPRITES_URL": "",
		// Origin of the RENDERS bucket's custom domain, e.g. https://renders.example.com. Empty means the
		// Worker serves render images at /prints/<id>/render/<file>; alchemy.run.ts sets it from
		// RENDERS_DOMAIN_<STAGE>.
		"RENDERS_URL": "",
		// Origin of the SCREENSHOTS bucket's custom domain, e.g. https://screenshots.example.com. Empty means
		// the Worker serves screenshots at /screenshots/<key>; alchemy.run.ts sets it from
		// SCREENSHOTS_DOMAIN_<STAGE>.
		"SCREENSHOTS_URL": "",
		// Cloudflare Turnstile on the removal-request form. Here Cloudflare's test key, which always passes
		// (src/lib/server/turnstile.ts pairs it with the test secret); alchemy.run.ts sets the real one from
		// TURNSTILE_SITE_KEY, with TURNSTILE_SECRET_KEY as a secret. Empty: the form is off.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		// The zone whose edge cache a takedown purges (the renders and screenshots domains), with
		// CACHE_PURGE_TOKEN as a secret; alchemy.run.ts sets it. Empty: the admin page lists what to purge.
		"CACHE_ZONE_ID": ""
	}
}
