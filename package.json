{
	"name": "factorio-atlas",
	"version": "0.0.1",
	"private": true,
	"description": "A searchable index of Factorio blueprints from factorioprints.com, decoded and analysed",
	"homepage": "https://github.com/jsmenzies/factorio-atlas#readme",
	"bugs": "https://github.com/jsmenzies/factorio-atlas/issues",
	"license": "MIT",
	"author": "James Menzies",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jsmenzies/factorio-atlas.git"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"gen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply DB --local",
		"ingest": "bun scripts/ingest.ts",
		"backfill": "bun scripts/backfill.ts",
		"backfill:status": "bun scripts/backfill.ts --status",
		"render": "bun scripts/render-game.ts",
		"render:resume": "bun scripts/render-game.ts --resume",
		"render:top": "bun scripts/render-scope.ts top",
		"render:check": "bun scripts/render-scope.ts check",
		"render:flags": "bun scripts/render-flags.ts",
		"render:thumbs": "bun scripts/render-thumbs.ts",
		"views:sync": "bun scripts/views-sync.ts",
		"authors": "bun scripts/authors.ts",
		"screenshots": "bun scripts/screenshots.ts",
		"screenshots:flags": "bun scripts/screenshots-flags.ts",
		"screenshots:remove": "bun scripts/screenshots-remove.ts",
		"game-data": "bun scripts/build-game-data.ts",
		"icons": "bun scripts/icons.ts",
		"lint": "oxlint",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"plan:prod": "bun run build && alchemy plan --stage prod",
		"deploy:prod": "bun run build && alchemy deploy --stage prod"
	},
	"dependencies": {
		"effect": "4.0.5",
		"marked": "18.0.14",
		"xss": "1.0.15"
	},
	"devDependencies": {
		"@distilled.cloud/cloudflare": "1.0.0-rc.13",
		"@effect/platform-bun": "4.0.5",
		"@effect/platform-node": "4.0.5",
		"@rickyzhangca/fpsr": "0.0.3",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"alchemy": "2.0.0-beta.81",
		"aws4fetch": "1.0.20",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"sharp": "0.35.5",
		"skia-canvas": "2.0.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"wrangler": "^4.97.0"
	},
	"engines": {
		"bun": ">=1.4.3"
	},
	"trustedDependencies": [
		"skia-canvas"
	]
}
